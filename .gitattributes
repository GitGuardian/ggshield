# `include_str!` embeds these byte for byte, and Rust normalizes CRLF to LF
# inside source string literals but not in included files. Without this, a
# Windows checkout (core.autocrlf=true) puts CRLF in the hook's output.
rust/hook/src/templates/*.in text eol=lf

# The notification icons are embedded with `include_bytes!`, so newline rewriting
# would corrupt them.
rust/hook/assets/*.png binary
rust/hook/assets/*.icns binary

# Contract tests compare bytes. Inputs (work/) may hold CRLF line endings or
# unusual encodings on purpose, and recordings are written with \n by the
# harness: a Windows checkout (core.autocrlf=true) must not rewrite either.
tests/contract/**/work/** -text
tests/contract/**/home/** -text
tests/contract/**/config/** -text
tests/contract/**/data/** -text
tests/contract/**/expected/** -text
tests/contract/**/api_calls.yaml -text
